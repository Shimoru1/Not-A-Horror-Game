			P: "3dsMax|ClassIDa", "int", "Integer", "",2140830621
			P: "3dsMax|ClassIDb", "int", "Integer", "",1875767309
			P: "3dsMax|SuperClassID", "int", "Integer", "",3088
			P: "3dsMax|params", "Compound", "", ""
			P: "3dsMax|MaxTexture", "KString", "", "", "OSLMap"
			P: "3dsMax|params|OSLPath", "KString", "", "A", "C:\Program Files\Autodesk\3ds Max 2022\OSL\Noise.osl"
			P: "3dsMax|params|OSLCode", "KString", "", "A", "// General Noise Shader, returning a float (1D)&cr;&lf;// Noise.osl by Zap Andersson&cr;&lf;// Modified: 2019-11-26&cr;&lf;// Copyright 2019 Autodesk Inc, All rights reserved. This file is licensed under Apache 2.0 license&cr;&lf;//    https://github.com/ADN-DevTech/3dsMax-OSL-Shaders/blob/license/LICENSE.txt&cr;&lf;&cr;&lf;shader Noise&cr;&lf;[[ string help=&quot;A shader for generating more advanced noise&quot; ]]&cr;&lf;(&cr;&lf;	point  UVW    = transform(&quot;object&quot;, P)&cr;&lf;		[[ string help = &quot;The UVW coordinate to use. When not connected, defaults to Object space&quot; ]],	&cr;&lf;	float  Scale  = 25.0,&cr;&lf;	string Type   = &quot;uperlin&quot;&cr;&lf;		[[ string widget= &quot;popup&quot;, &cr;&lf;		   string help  = &quot;Use perlin, uperlin, cell, hash, simplex or gabor&quot;,&cr;&lf;		   string options=&quot;perlin|uperlin|cell|hash|simplex|gabor&quot; ]],&cr;&lf;	int   Octaves    = 4&cr;&lf;		[[ string help = &quot;Hos many layers of noise are mixed together&quot; ]],&cr;&lf;	float Lacunarity = 2.0&cr;&lf;		[[ string help = &quot;How much the 'frequency' of the noise changes per layer&quot; ]],	&cr;&lf;	float Gain       = 0.5&cr;&lf;		[[ string help = &quot;How much the amplitude of the noise changes per layer. Higher numbers means higher noise frequencies have more effect.&quot; ]],		&cr;&lf;	&cr;&lf;	int   StepFunction = 1 &cr;&lf;		[[ string widget= &quot;checkBox&quot;,&cr;&lf;		   string label = &quot;Step Function&quot;,&cr;&lf;		   string help  = &quot;Enables a per-layer smoothstep curve in the noise, allowing you to increase the 'contrast' of the noise&quot; ]],&cr;&lf;	float LowStep = 0.5&cr;&lf;		[[ string help = &quot;Low threshold of the smoothstep function.&quot;,&cr;&lf;		   string label = &quot;Low Step&quot;,&cr;&lf;		   float  min = -1.0, float max = 1.0 ]],		&cr;&lf;	float HiStep = 0.8&cr;&lf;		[[ string help = &quot;High threshold of the smoothstep function.&quot;,&cr;&lf;		   string label = &quot;High Step&quot;,		&cr;&lf;		   float  min = -1.0, float max = 1.0 ]],		&cr;&lf;	int   Normalize = 1 &cr;&lf;		[[ string widget= &quot;checkBox&quot;,&cr;&lf;		   string help = &quot;If the noise is auto-normalized to Amplitude or not.&quot; ]],&cr;&lf;	float Amplitude = 1.0&cr;&lf;		[[ string help = &quot;The amplitude of the noise.&quot; ]],		&cr;&lf;	float Phase     = 0.0&cr;&lf;		[[ string help = &quot;The 'Phase' is just a 4th coordinate of the noise, can be used to allow it to evolve over time, for example.&quot; ]],	&cr;&lf;		   &cr;&lf;	output float Out = 0,&cr;&lf;)&cr;&lf;{&cr;&lf;	point pnt = UVW / Scale;&cr;&lf;	&cr;&lf;	float sum = 0;&cr;&lf;	float curFreq = 1.0;&cr;&lf;	float curAmp = Amplitude;&cr;&lf;	&cr;&lf;	// Loop over number of octaves&cr;&lf;	for (int i = 0; i < Octaves; i++)&cr;&lf;	{			&cr;&lf;		// Compute a noise value&cr;&lf;		float ns = noise(Type, pnt * curFreq, Phase + i);&cr;&lf;		&cr;&lf;		if (StepFunction)&cr;&lf;			ns = smoothstep(LowStep, HiStep, ns);&cr;&lf;&cr;&lf;		// Add our result to the output							&cr;&lf;		Out += ns * curAmp;&cr;&lf;		// Add the amplitude to the normalizing sum&cr;&lf;		sum += curAmp;&cr;&lf;&cr;&lf;		// Step up frequency and amplitude		&cr;&lf;		curFreq *= Lacunarity;&cr;&lf;		curAmp  *= Gain;		&cr;&lf;	}&cr;&lf;	&cr;&lf;	if (Normalize)&cr;&lf;		Out /= sum / Amplitude;&cr;&lf;}&cr;&lf;"
             
			P: "3dsMax|params|OSLAutoUpdate", "Bool", "", "A",1
			P: "3dsMax|params|OSLShaderName", "KString", "", "A", "Noise"
			P: "3dsMax|Noise", "Compound", "", ""
			P: "3dsMax|Noise|Scale", "Float", "", "A",1
			P: "3dsMax|Noise|Type", "KString", "", "A", "uperlin"
			P: "3dsMax|Noise|Octaves", "Integer", "", "A",4
			P: "3dsMax|Noise|Lacunarity", "Float", "", "A",2
			P: "3dsMax|Noise|Gain", "Float", "", "A",0.5
