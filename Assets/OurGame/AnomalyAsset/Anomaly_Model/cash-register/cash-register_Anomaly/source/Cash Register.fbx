			P: "3dsMax|Noise|Normalize", "Integer", "", "A",1
			P: "3dsMax|Noise|Amplitude", "Float", "", "A",1
			P: "3dsMax|Noise|Phase", "Float", "", "A",0
			P: "3dsMax|Noise|UVW_map", "Reference", "", "A"
			P: "3dsMax|Noise|Scale_map", "Reference", "", "A"
			P: "3dsMax|Noise|Type_map", "Reference", "", "A"
			P: "3dsMax|Noise|Octaves_map", "Reference", "", "A"
